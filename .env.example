# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://homeops:homeops@localhost:5432/homeops

# ── App ──────────────────────────────────────────────────────────────────────
# Secret for session/cookie signing — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-strong-random-value

# ── AI explanation (Session 4+) ───────────────────────────────────────────────
# Anthropic API key — only used server-side for generating explanations
ANTHROPIC_API_KEY=sk-ant-...

# ── Home Assistant integration (Session 5+, optional) ────────────────────────
# Set USE_SYNTHETIC_DATA=true to skip HA entirely (safe for public repo / CI)
USE_SYNTHETIC_DATA=true
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# Comma-separated list of entity IDs HomeOps is allowed to read.
# No cameras, people, locks, alarms, or location entities.
ALLOWED_HA_ENTITIES=sensor.battery_soc,sensor.pv_production_kw,sensor.consumption_kw,sensor.grid_kw,sensor.solar_forecast_kwh
